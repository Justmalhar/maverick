    "black": "#1d1d22",
    "red": "#ef4444",
    "green": "#22c55e",
    "yellow": "#eab308",
    "blue": "#3b82f6",
    "magenta": "#a855f7",
    "cyan": "#06b6d4",
    "white": "#e5e5e5",
    "brightBlack": "#8a8a94",
    "brightRed": "#f87171",
    "brightGreen": "#4ade80",
    "brightYellow": "#facc15",
    "brightBlue": "#60a5fa",
    "brightMagenta": "#c084fc",
    "brightCyan": "#22d3ee",
    "brightWhite": "#fafafa"
  },
  "syntax": {
    "keyword": "#c084fc",
    "string": "#86efac",
    "comment": "#7e828c",
    "number": "#fcd34d",
    "function": "#7dabf8",
    "type": "#5fd4e8"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#7e828c", "fontStyle": "italic" }
    },
    {
      "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.language"],
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": ["entity", "entity.name"],
      "settings": { "foreground": "#7dabf8" }
    },
    {
      "scope": "variable.parameter.function",
      "settings": { "foreground": "#f5f5f7" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#86efac" }
    },
    {
      "scope": "keyword",
      "settings": { "foreground": "#c084fc" }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "scope": ["string", "punctuation.definition.string", "string punctuation.section.embedded source"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "scope": "support",
      "settings": { "foreground": "#5fd4e8" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#f5f5f7" }
    },
    {
      "scope": "variable.other",
      "settings": { "foreground": "#e5e5e5" }
    }
  ],
  "semanticHighlighting": true
}
